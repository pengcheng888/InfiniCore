+    } else if (max_threads >= METAX_BLOCK_SIZE_128) {
+        CHECK_STATUS(launchKernel<METAX_BLOCK_SIZE_128>(batch_size, nhead, dim, y, _info.atype, stride_y_batch, stride_y_nhead, x, stride_x_batch, stride_x_nhead, w, _info.wtype, _info.epsilon, stream));
+    } else if (max_threads >= METAX_BLOCK_SIZE_64) {
+        CHECK_STATUS(launchKernel<METAX_BLOCK_SIZE_64>(batch_size, nhead, dim, y, _info.atype, stride_y_batch, stride_y_nhead, x, stride_x_batch, stride_x_nhead, w, _info.wtype, _info.epsilon, stream));
